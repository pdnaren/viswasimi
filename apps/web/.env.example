# Copy this file to .env.local and fill in real values. Never commit the real .env.local file.

# Base URL of the FastAPI backend, reachable from the browser.
# Leave unset in local dev — it auto-detects http://localhost:8000.
NEXT_PUBLIC_API_BASE_URL=

# Base URL of the FastAPI backend, reachable from the Next.js server
# (server components / route handlers). Defaults to http://127.0.0.1:8000.
API_BASE_URL=
