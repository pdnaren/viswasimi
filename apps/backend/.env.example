# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/viswasimi

# --- CORS ---------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# --- Auth / sessions ---------------------------------------------------------------
SESSION_DAYS=7
COOKIE_SECURE=false
DEFAULT_LOCALE=en-IN
DEFAULT_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:3000

# --- OpenAI (chat tutor) ---------------------------------------------------------------
OPENAI_API_KEY=

# --- Razorpay (payments) ---------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- RAG backend integration ---------------------------------------------------------------
RAG_BACKEND_URL=http://localhost:8001
INTERNAL_API_KEY=

# --- Outgoing email (password reset) — optional, leave blank to disable ---------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Optional integrations ---------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=
LLAMAPARSE_API_KEY=
